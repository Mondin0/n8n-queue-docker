WEBHOOK_URL=http://localhost:5678/
N8N_DISABLE_PRODUCTION_MAIN_PROCESS=true
N8N_PROTOCOL=http
N8N_HOST=localhost
GENERIC_TIMEZONE=America/Argentina/Buenos_Aires

MYSQL_ROOT_PASSWORD=ChangeRootPassword
